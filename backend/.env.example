APP_ENV=development
# SQLite development fallback. Relative paths resolve under backend/.
DATABASE_URL=sqlite:///./packsure.db
# Production example: postgresql+psycopg://USER:PASSWORD@localhost:5432/packsure
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Isolated PaddleOCR worker (Python 3.12); main API remains Python 3.14.
OCR_WORKER_PYTHON=.ocr-venv/Scripts/python.exe
OCR_TIMEOUT_SECONDS=300
OCR_MODEL_CACHE_DIR=.ocr-cache
REPORT_DIR=reports
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
